# ─── WhatsApp Cloud API ───────────────────────────────────────────────
# Get these from https://developers.facebook.com → your app → WhatsApp → API Setup

WHATSAPP_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=any_random_secret_string_you_choose

# Your personal WhatsApp number in international format (no + or spaces)
# Example: 201234567890 for Egypt +20 123 456 7890
MY_WHATSAPP_NUMBER=20XXXXXXXXXX

# ─── Server ───────────────────────────────────────────────────────────
PORT=3000

# ─── Retry Settings ───────────────────────────────────────────────────
# How often (in minutes) to re-send unacknowledged reminders
RETRY_INTERVAL_MINUTES=10

# Maximum number of retries before giving up (0 = retry forever)
MAX_RETRIES=0
